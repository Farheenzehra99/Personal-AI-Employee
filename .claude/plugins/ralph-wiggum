#!/usr/bin/env bash
# Ralph Wiggum Stop Hook - Keep Claude working until task is complete
# Reference: https://github.com/anthropics/claude-code/tree/main/.claude/plugins/ralph-wiggum

# Configuration
COMPLETION_FILE="${RALPH_COMPLETION_FILE:-}"
MAX_ITERATIONS="${RALPH_MAX_ITERATIONS:-10}"
ITERATION_FILE="/tmp/ralph_iterations_$$"
VAULT_PATH="/mnt/d/personal-ai-employee"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Function to count files in directory
count_files() {
    local dir="$1"
    if [ -d "$dir" ]; then
        find "$dir" -maxdepth 1 -type f -name "*.md" 2>/dev/null | wc -l
    else
        echo "0"
    fi
}

# Get current iteration
if [ -f "$ITERATION_FILE" ]; then
    ITERATION=$(cat "$ITERATION_FILE")
else
    ITERATION=0
fi

# Check if we've exceeded max iterations
if [ "$ITERATION" -ge "$MAX_ITERATIONS" ]; then
    echo -e "${RED}🛑 Ralph Wiggum: Max iterations ($MAX_ITERATIONS) reached. Stopping.${NC}"
    rm -f "$ITERATION_FILE"
    exit 0
fi

# Check completion conditions
SHOULD_CONTINUE=false
REASON=""

# Condition 1: Check if completion file directory has files
if [ -n "$COMPLETION_FILE" ] && [ -d "$COMPLETION_FILE" ]; then
    COUNT=$(count_files "$COMPLETION_FILE")
    if [ "$COUNT" -gt 0 ]; then
        SHOULD_CONTINUE=true
        REASON="Files still in $COMPLETION_FILE ($COUNT files)"
    fi
fi

# Condition 2: Check for unprocessed Needs_Action files
NEEDS_ACTION="$VAULT_PATH/Needs_Action"
if [ -d "$NEEDS_ACTION" ]; then
    COUNT=$(count_files "$NEEDS_ACTION")
    if [ "$COUNT" -gt 0 ]; then
        SHOULD_CONTINUE=true
        if [ -n "$REASON" ]; then
            REASON="$REASON; "
        fi
        REASON="${REASON}Unprocessed files in Needs_Action ($COUNT files)"
    fi
fi

# Condition 3: Check for pending plans
PLANS="$VAULT_PATH/Plans"
if [ -d "$PLANS" ]; then
    COUNT=$(count_files "$PLANS")
    if [ "$COUNT" -gt 0 ]; then
        # Check if any plans are still pending
        PENDING=$(grep -l "status: pending" "$PLANS"/*.md 2>/dev/null | wc -l)
        if [ "$PENDING" -gt 0 ]; then
            SHOULD_CONTINUE=true
            if [ -n "$REASON" ]; then
                REASON="$REASON; "
            fi
            REASON="${REASON}Pending plans ($PENDING pending)"
        fi
    fi
fi

# Condition 4: Check for pending approvals (don't continue, but report)
PENDING_APPROVALS="$VAULT_PATH/Pending_Approval"
if [ -d "$PENDING_APPROVALS" ]; then
    COUNT=$(count_files "$PENDING_APPROVALS")
    if [ "$COUNT" -gt 0 ]; then
        echo -e "${YELLOW}⏸️  Ralph Wiggum: Pending approvals found ($COUNT files)${NC}"
        echo -e "${YELLOW}   Waiting for human approval before continuing...${NC}"
        # Don't set SHOULD_CONTINUE - we wait for human
    fi
fi

# Print status header
echo ""
echo -e "${BLUE}╔════════════════════════════════════════════════════════╗${NC}"
echo -e "${BLUE}║          Ralph Wiggum Autonomous Loop                  ║${NC}"
echo -e "${BLUE}╚════════════════════════════════════════════════════════╝${NC}"
echo ""
echo -e "${BLUE}📊 Status:${NC} Iteration $ITERATION/$MAX_ITERATIONS"
echo ""

# Decide whether to continue or exit
if [ "$SHOULD_CONTINUE" = true ]; then
    # Increment iteration counter
    ITERATION=$((ITERATION + 1))
    echo "$ITERATION" > "$ITERATION_FILE"
    
    echo -e "${GREEN}🔄 Work Remaining:${NC}"
    echo "   $REASON"
    echo ""
    echo -e "${YELLOW}Continuing autonomous work...${NC}"
    echo ""
    
    # Non-zero exit triggers retry by Claude Code
    exit 1
else
    # Task complete!
    echo -e "${GREEN}✅ All Tasks Complete!${NC}"
    echo ""
    
    # Show summary
    echo -e "${BLUE}📈 Summary:${NC}"
    echo "   Total iterations: $ITERATION"
    echo "   Needs_Action: $(count_files "$NEEDS_ACTION") files"
    echo "   Plans: $(count_files "$PLANS") files"
    echo "   Pending Approval: $(count_files "$PENDING_APPROVALS") files"
    echo "   Done: $(count_files "$VAULT_PATH/Done") files"
    echo ""
    
    # Clean up
    rm -f "$ITERATION_FILE"
    exit 0
fi
